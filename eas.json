{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "expo prebuild && node scripts/fix-splash-screen.js"
    },
    "preview": {
      "distribution": "internal",
      "prebuildCommand": "expo prebuild && node scripts/fix-splash-screen.js"
    },
    "production": {
      "autoIncrement": true,
      "prebuildCommand": "expo prebuild && node scripts/fix-splash-screen.js"
    }
  },
  "submit": {
    "production": {}
  }
}
